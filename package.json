{
  "name": "sixfold",
  "version": "6.0.10",
  "release": "5.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Sixfold \u2014 an offline pocket arcade of six games.",
  "scripts": {
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1",
    "test": "playwright test",
    "test:i18n": "node scripts/check-i18n.mjs",
    "audit:wordle": "node scripts/audit-wordle-dictionaries.mjs",
    "audit:wordle:strict": "node scripts/audit-wordle-dictionaries.mjs --strict",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "native:build": "node scripts/build-native.mjs",
    "native:sync": "npm run native:build && npx cap sync",
    "native:android": "npm run native:build && npx cap sync android",
    "native:apk:debug": "npm run native:android && cd android && ./gradlew assembleDebug",
    "native:ios": "npm run native:build && npx cap sync ios",
    "native:assets": "npm run native:assets:android",
    "native:assets:android": "npx capacitor-assets generate --android --iconBackgroundColor \"#f6f1e8\" --iconBackgroundColorDark \"#1a1918\" --splashBackgroundColor \"#f6f1e8\" --splashBackgroundColorDark \"#1a1918\"",
    "native:assets:ios": "npx capacitor-assets generate --ios",
    "smoke:apk": "bash scripts/smoke-apk.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  }
}
