{
  "name": "sixfold",
  "version": "6.0.0",
  "release": "6.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Sixfold — an offline pocket arcade of six games.",
  "scripts": {
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1",
    "test": "playwright test",
    "test:i18n": "node scripts/check-i18n.mjs",
    "preflight": "node scripts/check-i18n.mjs && node scripts/check-webview-floor.mjs && node scripts/asset-manifest.mjs --check && node scripts/check-shell-pins.mjs && node scripts/check-native-pins.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:webview-floor": "node scripts/check-webview-floor.mjs",
    "test:death-report": "node --test scripts/lib/death-report.test.mjs",
    "test:reattach": "node --test scripts/lib/reattach.test.mjs",
    "test:app-removal": "node --test scripts/lib/app-removal.test.mjs",
    "test:emulator-retry": "bash scripts/test-emulator-retry.sh",
    "test:cache-budget": "node scripts/check-cache-budgets.mjs",
    "test:shell-pins": "node scripts/check-shell-pins.mjs",
    "test:shell-pins:fixture": "node --test scripts/lib/shell-pins.test.mjs",
    "test:unload-bridge": "node scripts/check-unload-bridge.mjs",
    "test:unload-bridge:fixture": "node --test scripts/lib/unload-bridge.test.mjs",
    "audit:wordle": "node scripts/audit-wordle-dictionaries.mjs",
    "audit:wordle:strict": "node scripts/audit-wordle-dictionaries.mjs --strict",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "native:build": "node scripts/build-native.mjs",
    "native:check": "node scripts/check-native-pins.mjs",
    "native:sync": "npm run native:build && npx cap sync && npm run native:check",
    "native:android": "npm run native:build && npx cap sync android && npm run native:check",
    "native:apk:debug": "npm run native:android && cd android && ./gradlew assembleDebug",
    "native:ios": "npm run native:build && npx cap sync ios && npm run native:check",
    "native:assets": "npm run native:assets:android",
    "native:assets:android": "npx capacitor-assets generate --android --iconBackgroundColor \"#211d18\" --iconBackgroundColorDark \"#211d18\" --splashBackgroundColor \"#f6f1e8\" --splashBackgroundColorDark \"#1a1918\" && python3 scripts/build-static-icons.py --write && node scripts/guard-adaptive-icon.mjs",
    "assets:icon": "node scripts/build-app-icon.mjs",
    "assets:icons": "python3 scripts/build-static-icons.py --write",
    "assets:icons:check": "node scripts/check-icon-snapshots.mjs",
    "assets:guard": "node scripts/guard-adaptive-icon.mjs --check",
    "assets:manifest": "node scripts/asset-manifest.mjs",
    "assets:manifest:check": "node scripts/asset-manifest.mjs --check",
    "assets:ios-splash": "node scripts/build-ios-splash.mjs",
    "assets:og": "node scripts/build-og-image.mjs",
    "native:assets:ios": "npx capacitor-assets generate --ios",
    "smoke:apk": "bash scripts/smoke-apk.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "acorn": "^8.19.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  }
}
